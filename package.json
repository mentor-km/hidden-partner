{
  "name": "hidden-partner",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.18.0",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "test": "node scripts/ensure-assets.mjs && vitest run",
    "build": "pnpm --filter @hidden-partner/web build && node scripts/check-web-build.mjs && pnpm --filter @hidden-partner/server run bundle && node scripts/check-worker-bundle.mjs",
    "deploy": "pnpm test && pnpm build && pnpm --filter @hidden-partner/server run deploy",
    "smoke": "node --experimental-strip-types scripts/smoke.ts",
    "e2e": "pnpm --filter @hidden-partner/web e2e",
    "simulate": "node --experimental-strip-types packages/rules/scripts/simulate.ts",
    "calibrate": "node --experimental-strip-types packages/rules/scripts/calibrate.ts",
    "demo": "node --experimental-strip-types packages/rules/scripts/demo.ts",
    "lobby-demo": "pnpm --filter @hidden-partner/server lobby-demo",
    "match-demo": "pnpm --filter @hidden-partner/server match-demo"
  },
  "devDependencies": {
    "typescript": "^7.0.2",
    "vitest": "^5.1.0"
  }
}
