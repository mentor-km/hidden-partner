{
  "name": "hidden-partner",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.18.0",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "test": "vitest run",
    "e2e": "pnpm --filter @hidden-partner/web e2e",
    "simulate": "node --experimental-strip-types packages/rules/scripts/simulate.ts",
    "calibrate": "node --experimental-strip-types packages/rules/scripts/calibrate.ts",
    "demo": "node --experimental-strip-types packages/rules/scripts/demo.ts",
    "lobby-demo": "pnpm --filter @hidden-partner/server lobby-demo",
    "match-demo": "pnpm --filter @hidden-partner/server match-demo"
  },
  "devDependencies": {
    "typescript": "^7.0.2",
    "vitest": "^5.1.0"
  }
}
